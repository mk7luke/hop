[Unit]
Description=Hop redirect follower (hop.hermz.xyz)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/luke/tools/hop
Environment=HOP_HOST=127.0.0.1
Environment=HOP_PORT=8884
Environment=HOP_PUBLIC_HOST=https://hop.hermz.xyz
ExecStart=/home/luke/tools/hop/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8884 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
